{
  "name": "otty-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run prepare:docs && npm run build:site",
    "build:site": "node scripts/verify-documentation-stage.mjs && astro build",
    "check": "npm run prepare:docs && npm run check:site",
    "check:site": "node scripts/verify-documentation-stage.mjs && astro check",
    "dev": "npm run prepare:docs && npm run dev:site",
    "dev:site": "node scripts/verify-documentation-stage.mjs && astro dev",
    "prepare:docs": "node scripts/prepare-documentation.mjs",
    "preview": "astro preview",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.10",
    "@mdx-js/mdx": "^3.1.1",
    "astro": "^7.2.9",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
