---
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="OTTY is an Early Release Terminal-first Workspace for development and operations across local and remote machines."
    />
    <link href={canonicalUrl} rel="canonical" />
    <link href="/assets/logo-small.svg" rel="icon" type="image/svg+xml" />
    <title>OTTY — Terminal-first Workspace</title>
  </head>
  <body>
    <header>
      <a class="identity" href="/" aria-label="OTTY Product Landing">
        <img src="/assets/logo-small.svg" alt="" width="32" height="32" />
        <span>OTTY</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/docs/">Documentation</a>
        <a href="/docs/install/">Installation and Downloads</a>
        <a href="https://github.com/otty-shell/otty">GitHub</a>
      </nav>
    </header>

    <main>
      <p class="eyebrow">Early Release</p>
      <h1>OTTY</h1>
      <p class="lede">
        OTTY is a Terminal-first Workspace for development and operations across local and remote
        machines.
      </p>
      <div class="actions">
        <a class="primary" href="/docs/install/">Install OTTY</a>
        <a href="/docs/">Read Documentation</a>
      </div>
    </main>

    <footer>
      <span>OTTY</span>
      <a href="/docs/">Documentation</a>
      <a href="https://github.com/otty-shell/otty">GitHub</a>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #090d12;
    color: #edf4f7;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  header,
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem clamp(1.25rem, 5vw, 5rem);
    border-color: #25303a;
  }

  header {
    border-bottom: 1px solid #25303a;
  }

  footer {
    border-top: 1px solid #25303a;
  }

  nav,
  footer {
    flex-wrap: wrap;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: #9ee7d8;
  }

  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  main {
    width: min(46rem, calc(100% - 2.5rem));
    margin: auto;
    padding-block: 5rem;
  }

  .eyebrow {
    color: #9ee7d8;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 16vw, 9rem);
    line-height: 0.9;
  }

  .lede {
    max-width: 42rem;
    font-size: clamp(1.35rem, 3vw, 2.15rem);
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions a {
    padding: 0.8rem 1rem;
    border: 1px solid #3b4a55;
    border-radius: 0.4rem;
    text-decoration: none;
  }

  .actions .primary {
    border-color: #9ee7d8;
    background: #9ee7d8;
    color: #091210;
    font-weight: 700;
  }

  footer {
    justify-content: flex-start;
  }

  @media (max-width: 44rem) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
